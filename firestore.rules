rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // PRODUCTION HARDENED ZERO-TRUST ROLE-BASED ACCESS CONTROL (RBAC) RULES
    // =========================================================================
    // Reusable, hardened security helper primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'ADMIN' || getUserRole() == 'OWNER');
    }
    
    function isAcademicStaff() {
      return isSignedIn() && getUserRole() == 'ACADEMIC_STAFF';
    }
    
    function isAccountant() {
      return isSignedIn() && getUserRole() == 'ACCOUNTANT';
    }
    
    function isTeacher() {
      return isSignedIn() && getUserRole() == 'TEACHER';
    }
    
    function isStudent() {
      return isSignedIn() && getUserRole() == 'STUDENT';
    }
    
    function isParent() {
      return isSignedIn() && getUserRole() == 'PARENT';
    }
    
    function isStaff() {
      return isAdmin() || isAcademicStaff() || isAccountant() || isTeacher();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{id} {
      // Any authenticated user can read profiles (needed for displays and lookups)
      allow read: if isSignedIn();
      // Only self or Admin or Academic Staff can create
      allow create: if isSignedIn() && (request.auth.uid == id || isAdmin() || isAcademicStaff());
      // Users cannot change their own roles (Prevent Self-Assigned Roles)
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == id && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status)
      );
      // Only Admin can delete users
      allow delete: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff();
    }

    match /classes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff();
    }

    match /parents/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff();
    }

    match /students/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff();
    }

    match /classEnrollments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff();
    }

    match /invoices/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    match /payments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAccountant();
    }

    match /teacherAssignments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff();
    }

    match /schedules/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff();
    }

    match /scores/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff() || isTeacher();
    }

    match /expenses/{id} {
      allow read, write: if isAdmin() || isAccountant();
    }

    match /homeworks/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcademicStaff() || isTeacher();
    }

    match /employees/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /reports/{id} {
      allow read: if isAdmin() || isAcademicStaff() || isAccountant();
      allow write: if isAdmin() || isAcademicStaff();
    }
  }
}
