    "schedules": {
      "schema": "Schedule",
      "description": "School timetable sessions schedule"
    },
    "scores": {
      "schema": "Score",
      "description": "Midterm, regular, and final scorebooks"
    },
    "expenses": {
      "schema": "Expense",
      "description": "Internal business center operating expenses"
    },
    "homeworks": {
      "schema": "Homework",
      "description": "Assigned homework tasks per class"
    },
    "employees": {
      "schema": "Employee",
      "description": "Academic center administrative employees"
    },
    "notifications": {
      "schema": "Notification",
      "description": "Real-time user and system alerts"
    },
    "auditLogs": {
      "schema": "AuditLog",
