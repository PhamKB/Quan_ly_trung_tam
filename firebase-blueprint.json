  "firestore": {
    "subjects": {
      "schema": "Subject",
      "description": "List of available school subjects"
    },
    "teachers": {
      "schema": "Teacher",
      "description": "List of educational center teachers"
    },
    "classes": {
      "schema": "Class",
      "description": "List of available classrooms"
    },
    "users": {
      "schema": "User",
      "description": "List of registered ERP users"
    },
    "parents": {
      "schema": "Parent",
